# Copie este arquivo para ".env" e ajuste os valores.
# NUNCA envie o arquivo .env para o Git.

# Chave secreta (obrigatória em produção). Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-esta-chave-por-uma-gerada-aleatoriamente

# True apenas em desenvolvimento
DEBUG=True

# Domínios permitidos, separados por vírgula
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens confiáveis para formulários (produção com HTTPS), separadas por vírgula
# Ex.: https://canguaretama.ifrn.edu.br
CSRF_TRUSTED_ORIGINS=

# --- Publicação sob subcaminho -------------------------------------------
# Em desenvolvimento deixe FORCE_SCRIPT_NAME vazio.
# Em produção, ex.: FORCE_SCRIPT_NAME=/vagas  (site em https://dominio/vagas/)
FORCE_SCRIPT_NAME=
# Relativo ("static/") recebe o prefixo automaticamente: /vagas/static/
STATIC_URL=static/
# Nome da rota ou caminho da tela de login
LOGIN_URL=prefeituras:entrar

# --- Widget incorporável --------------------------------------------------
# Quem pode exibir /widget/ultimas-vagas/ em <iframe> (CSP frame-ancestors)
# Ex.: 'self' https://portal.ifrn.edu.br
WIDGET_FRAME_ANCESTORS='self'

# --- Anti-spam ------------------------------------------------------------
LIMITE_SOLICITACOES_POR_HORA=5
# True somente atrás do Nginx enviando o cabeçalho X-Real-IP
CONFIAR_PROXY_REVERSO=False
